#!/usr/bin/env bash
# Convenience launcher for autoblur.
# Creates a local virtualenv with the required deps on first run, then forwards
# all arguments to autoblur.py.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/.venv"
PY="$VENV/bin/python"

if [[ ! -x "$PY" ]]; then
  echo "First run: creating virtualenv and installing dependencies..." >&2
  python3 -m venv "$VENV"
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$HERE/requirements.txt"
fi

exec "$PY" "$HERE/autoblur.py" "$@"
